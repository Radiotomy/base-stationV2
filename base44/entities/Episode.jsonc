{
  "name": "Episode",
  "type": "object",
  "description": "ORVO Studio podcast episode. Audio pinned to Pinata IPFS.",
  "properties": {
    "podcast_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Creator/owner id"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "episode_number": {
      "type": "number"
    },
    "season_number": {
      "type": "number",
      "default": 1
    },
    "audio_url": {
      "type": "string",
      "description": "Pinata gateway URL"
    },
    "storage_audio_url": {
      "type": "string",
      "description": "Reliable Base44 storage copy of the episode audio \u2014 the forensic marking source. IPFS gateways are rate-limited and cannot be trusted as the only copy."
    },
    "ipfs_hash": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "thumbnail_ipfs_hash": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "published_date": {
      "type": "string",
      "format": "date-time"
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "chapters": {
      "type": "array",
      "description": "Chapter markers: {title, start_seconds}",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "start_seconds": {
            "type": "number"
          }
        }
      }
    },
    "transcript": {
      "type": "string",
      "description": "Full transcript text (AssemblyAI, Phase 3+)"
    },
    "play_count": {
      "type": "number",
      "default": 0
    },
    "like_count": {
      "type": "number",
      "default": 0
    },
    "base_mark_asset_id": {
      "type": "string",
      "description": "UserAsset id carrying this episode's BASE Mark cascade \u2014 the asset is the forensic record, the episode links to it"
    },
    "provenance_status": {
      "type": "string",
      "enum": [
        "unregistered",
        "processing",
        "marked",
        "failed"
      ],
      "default": "unregistered",
      "description": "BASE Mark registration state for this episode's audio"
    },
    "declared_origin": {
      "type": "string",
      "enum": [
        "human",
        "ai_assisted",
        "ai_generated"
      ],
      "description": "Creator's own attestation of how this episode was made. RIAA/IFPI-style disclosure is DECLARED by the rights holder, not detected: the platform has no AI-speech classifier, so this attestation is the authoritative origin signal. Absent this, the label stays 'unverified' \u2014 never 'ai_generated'."
    },
    "external_provenance": {
      "type": "object",
      "description": "Tier 1 foreign-provenance scan: provenance the SOURCE TOOL declared inside the uploaded container (originating workstation, encoder software, coding history, origination date). Read-only evidence about an outside upload \u2014 it never overrides the creator's attestation, and an empty result means the file carried no such metadata rather than that the file is suspect."
    },
    "ai_disclosure_label": {
      "type": "string",
      "enum": [
        "ai_generated",
        "ai_assisted",
        "human",
        "unverified"
      ],
      "description": "Disclosure label derived from the creator's attestation plus observed COS telemetry. 'unverified' means origin was never declared and no AI use was observed \u2014 it is NOT an accusation of AI authorship."
    },
    "ai_disclosure_basis": {
      "type": "string",
      "description": "Human-readable explanation of the assigned label"
    },
    "human_participation_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "0-100 Creative Ownership Score for this episode"
    },
    "participation_signals": {
      "type": "object",
      "description": "Breakdown of COS signals and points for this episode"
    },
    "chain_status": {
      "type": "string",
      "enum": [
        "unregistered",
        "pending",
        "registered",
        "failed"
      ],
      "default": "unregistered",
      "description": "On-chain provenance anchor state for this episode"
    },
    "chain_network": {
      "type": "string",
      "enum": [
        "base-mainnet",
        "solana-mainnet"
      ],
      "default": "base-mainnet",
      "description": "Chain the provenance anchor lives on (Solana support planned)"
    },
    "chain_registry_id": {
      "type": "string",
      "description": "BaseTrackRegistry record id for this episode's anchor"
    },
    "chain_tx_hash": {
      "type": "string",
      "description": "Anchor transaction hash"
    },
    "chain_metadata_uri": {
      "type": "string",
      "description": "IPFS URI of the pinned provenance bundle"
    }
  },
  "required": [
    "podcast_id",
    "user_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}