{
  "name": "OrvoLiveEvent",
  "type": "object",
  "description": "ORVO scheduled live podcast event \u2014 manually produced audio or video broadcast, optionally with an AI co-host, and archived to an episode when it ends.",
  "properties": {
    "host_id": {
      "type": "string"
    },
    "podcast_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "ended",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "audio",
        "video"
      ],
      "default": "audio",
      "description": "Whether the broadcast is audio-only or video"
    },
    "stream_url": {
      "type": "string",
      "description": "Live delivery URL the audience watches/listens to \u2014 YouTube/Twitch/Vimeo embed link or a direct stream URL"
    },
    "recording_url": {
      "type": "string",
      "description": "Archived recording captured in the broadcast console"
    },
    "archived_episode_id": {
      "type": "string",
      "description": "Episode created from the archived recording"
    },
    "is_ai_hosted": {
      "type": "boolean",
      "default": false
    },
    "listener_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "host_id",
    "podcast_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.host_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.host_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.host_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}