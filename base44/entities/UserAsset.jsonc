{
  "name": "UserAsset",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the asset owner"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the asset owner"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "track",
        "lyric",
        "coverart",
        "project",
        "stem",
        "video",
        "master",
        "harmony",
        "mashup",
        "visualizer"
      ],
      "description": "Type of asset"
    },
    "title": {
      "type": "string",
      "description": "Asset title or name"
    },
    "description": {
      "type": "string",
      "description": "Asset description"
    },
    "file_url": {
      "type": "string",
      "description": "URL to the asset file"
    },
    "metadata": {
      "type": "object",
      "description": "Asset-specific metadata (BPM, key, duration, audius_track_id, provenance, etc.)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for organization and search"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Whether asset is publicly visible"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL to thumbnail image for cover art or track"
    },
    "related_track_id": {
      "type": "string",
      "description": "ID of related track submission if applicable"
    },
    "origin": {
      "type": "string",
      "enum": [
        "creator",
        "loudly",
        "audius"
      ],
      "default": "creator",
      "description": "Content origin tag for legal separation. creator=user-generated AI; loudly=Loudly catalog/AI; audius=imported from Audius"
    },
    "parent_asset_id": {
      "type": "string",
      "description": "Phase 3: Source asset this was derived from (for stems, mashups, masters, harmonies, visualizers)"
    },
    "stem_type": {
      "type": "string",
      "enum": [
        "vocals",
        "drums",
        "bass",
        "other",
        "instruments",
        "melody",
        "harmony",
        "fx"
      ],
      "description": "Phase 3: For asset_type=stem, which stem this represents"
    }
  },
  "required": [
    "user_id",
    "asset_type",
    "title",
    "file_url"
  ]
}