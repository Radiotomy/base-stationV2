{
  "name": "UserAsset",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the asset owner"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the asset owner"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "track",
        "lyric",
        "coverart",
        "project",
        "stem",
        "video",
        "master",
        "harmony",
        "mashup",
        "visualizer",
        "sfx",
        "loop"
      ],
      "description": "Type of asset. 'loop' rows are the provenance registry entries for generated LoopSample loops \u2014 the loop library still reads LoopSample, but the forensic registry is indexed here, so a loop needs a row to be attributable at all."
    },
    "title": {
      "type": "string",
      "description": "Asset title or name"
    },
    "description": {
      "type": "string",
      "description": "Asset description"
    },
    "file_url": {
      "type": "string",
      "description": "URL to the asset file"
    },
    "metadata": {
      "type": "object",
      "description": "Asset-specific metadata (BPM, key, duration, audius_track_id, provenance, etc.)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for organization and search"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Whether asset is publicly visible"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL to thumbnail image for cover art or track"
    },
    "related_track_id": {
      "type": "string",
      "description": "ID of related track submission if applicable"
    },
    "workspace_id": {
      "type": "string",
      "description": "Optional Workspace id this asset belongs to (empty = unassigned / All)"
    },
    "loop_sample_id": {
      "type": "string",
      "description": "LoopSample this registry row was created for, when asset_type is 'loop'. Kept so a recovered payload can be traced back to the loop a creator actually sees in their library."
    },
    "lead_sheet_id": {
      "type": "string",
      "description": "LeadSheet this asset was rendered from, when the audio performs a human-authored score. Load-bearing for attribution: it is the difference between a participation score that was INFERRED from prompt telemetry and one that is asserted because every pitch, syllable and duration came from a stored, hashed score. Absent on prompt-generated audio, and never inferred after the fact."
    },
    "origin": {
      "type": "string",
      "enum": [
        "creator",
        "audius"
      ],
      "default": "creator",
      "description": "Content origin tag for legal separation. creator=user-generated AI; audius=imported from Audius"
    },
    "ai_label": {
      "type": "string",
      "enum": [
        "ai_generated",
        "ai_assisted",
        "human",
        "unverified"
      ],
      "description": "RIAA/IFPI GenAI track-level label (July 2026 standard). ai_generated = GenAI created the entirety/primary portion of the sound recording; ai_assisted = substantially human recording with some GenAI expressive elements; human = no GenAI in the recording; unverified = origin never declared and no AI use observed. Applies to audio asset types only (not lyrics/cover art/video per the standard). Derived assets inherit the most AI-intensive label in their provenance chain."
    },
    "ai_disclosure_label": {
      "type": "string",
      "enum": [
        "ai_generated",
        "ai_assisted",
        "human",
        "unverified"
      ],
      "default": "ai_generated",
      "description": "RIAA/IFPI-style GenAI disclosure label. Derived from the human participation score for generated assets, or from the creator's own origin attestation for uploaded recordings. 'unverified' means origin was never declared and no AI use was observed \u2014 absence of creative-process telemetry must NOT be recorded as 'ai_generated'."
    },
    "ai_disclosure_basis": {
      "type": "string",
      "description": "Human-readable explanation of why this label was assigned"
    },
    "human_participation_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "0\u2013100 Creative Ownership Score of human creative input"
    },
    "participation_signals": {
      "type": "object",
      "description": "Breakdown of signals and points that built the score"
    },
    "ddex_ai_metadata": {
      "type": "object",
      "description": "DDEX-style granular AI attribution profile derived from COS telemetry, exportable for downstream partner channels",
      "properties": {
        "ai_lyrical_content": {
          "type": "boolean",
          "description": "True if text/lyrics were generated via LLM without human script input"
        },
        "ai_composition": {
          "type": "boolean",
          "description": "True if baseline chord progressions or melodies were auto-generated"
        },
        "ai_instrumentation": {
          "type": "boolean",
          "description": "True if backing stems or instruments were synthesised purely from text prompts"
        },
        "ai_generated_vocals": {
          "type": "boolean",
          "description": "True if synthetic vocal profiles or cloned voice identities were utilized"
        },
        "ai_post_production": {
          "type": "boolean",
          "description": "True if mastering or balance engineers were automated utilities"
        }
      }
    },
    "c2pa_provenance_hash": {
      "type": "string",
      "description": "Cryptographic manifest checksum anchoring the COS metrics to the audio container"
    },
    "chain_status": {
      "type": "string",
      "enum": [
        "unregistered",
        "awaiting_mark",
        "pending",
        "registered",
        "failed",
        "skipped"
      ],
      "default": "unregistered",
      "description": "On-chain provenance anchor state for this asset. 'awaiting_mark' holds the anchor until the BASE Mark V1+V2 cascade has finalized and the C2PA manifest has been sealed over the watermarked audio \u2014 so the anchored fingerprint is the delivered file, never the raw export. 'skipped' records that automatic anchoring considered this asset and deliberately passed on it (owner has not opted in, the type is not anchorable, or the watermark cascade could not complete) \u2014 distinct from 'unregistered', which means nothing has looked yet."
    },
    "chain_registry_id": {
      "type": "string",
      "description": "BaseTrackRegistry record id for this asset's anchor"
    },
    "chain_tx_hash": {
      "type": "string",
      "description": "Anchor transaction hash"
    },
    "parent_asset_id": {
      "type": "string",
      "description": "Phase 3: Source asset this was derived from (for stems, mashups, masters, harmonies, visualizers)"
    },
    "stem_type": {
      "type": "string",
      "enum": [
        "vocals",
        "drums",
        "bass",
        "other",
        "instruments",
        "melody",
        "harmony",
        "fx"
      ],
      "description": "Phase 3: For asset_type=stem, which stem this represents"
    }
  },
  "required": [
    "user_id",
    "asset_type",
    "title",
    "file_url"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}