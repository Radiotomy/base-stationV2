{
  "name": "ProviderBalance",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "loudly",
        "nuro",
        "sonic",
        "producer",
        "tempcolor",
        "ltx"
      ],
      "description": "External API provider"
    },
    "api_key": {
      "type": "string",
      "description": "Encrypted API key reference"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Current account balance with provider"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "last_checked": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "error"
      ],
      "default": "active"
    },
    "error_message": {
      "type": "string"
    },
    "monthly_usage": {
      "type": "number",
      "default": 0
    },
    "monthly_limit": {
      "type": "number"
    },
    "health_status": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "offline",
        "unknown"
      ],
      "default": "unknown",
      "description": "Phase 3: Real-time health from latency + error rate checks"
    },
    "latency_ms": {
      "type": "number",
      "description": "Phase 3: Average latency in milliseconds from last health check"
    },
    "success_rate": {
      "type": "number",
      "description": "Phase 3: Recent success rate (0.0\u20131.0)"
    },
    "score": {
      "type": "number",
      "description": "Phase 3: Composite provider score (0\u2013100) for ranking"
    },
    "last_health_check": {
      "type": "string",
      "format": "date-time",
      "description": "Phase 3: Last time health was assessed"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for SEO and discoverability"
    }
  },
  "required": [
    "provider"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}