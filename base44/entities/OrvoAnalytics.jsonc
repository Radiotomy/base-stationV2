{
  "name": "OrvoAnalytics",
  "type": "object",
  "description": "ORVO listening analytics event (play, complete, share).",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "play",
        "pause",
        "complete",
        "share",
        "download"
      ],
      "default": "play"
    },
    "episode_id": {
      "type": "string"
    },
    "podcast_id": {
      "type": "string"
    },
    "listener_id": {
      "type": "string"
    },
    "creator_id": {
      "type": "string",
      "description": "Podcast owner \u2014 lets creators read their own show analytics"
    },
    "position_seconds": {
      "type": "number"
    }
  },
  "required": [
    "event_type",
    "episode_id"
  ],
  "rls": {
    "create": {
      "data.listener_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "data.listener_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}