{
  "name": "AudiusCredential",
  "type": "object",
  "description": "A creator's own Audius OAuth grant, enabling per-creator publishing: tracks they publish are uploaded to THEIR Audius account instead of the platform's app account. Written and read SERVER-SIDE ONLY \u2014 the access and refresh tokens are bearer credentials for the creator's entire Audius account, so RLS denies all client access and backend functions return only a connection status, never the tokens. Deliberately separate from the audius profile snapshot in User.metadata: that snapshot is public display data, this row is key material, and the two must never share a storage location.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "BASE Station creator this grant belongs to"
    },
    "user_email": {
      "type": "string"
    },
    "access_token": {
      "type": "string",
      "description": "Short-lived Audius bearer token. Never returned to any client under any circumstance."
    },
    "refresh_token": {
      "type": "string",
      "description": "Long-lived token used to mint new access tokens. Audius ROTATES this on every refresh, so the stored value must be overwritten each time \u2014 reusing a spent refresh token invalidates the grant and silently logs the creator out."
    },
    "scope": {
      "type": "string",
      "enum": [
        "read",
        "write"
      ],
      "default": "write",
      "description": "What the creator actually consented to. Recorded rather than assumed: a 'read' grant cannot publish, and attempting a write on one produces an unauthorized upload rather than a clear refusal."
    },
    "audius_user_id": {
      "type": "string",
      "description": "Audius ENCODED (hashed) user id, e.g. 'eAZl3'. This is the form the upload SDK requires. Deliberately stored alongside the numeric id rather than derived: the two are not interchangeable and passing the numeric one to an upload fails."
    },
    "audius_numeric_id": {
      "type": "number",
      "description": "Numeric user id as reported by Audius' /v1/me. Kept because that endpoint returns only this form, so it is the value proving which account the grant belongs to."
    },
    "handle": {
      "type": "string",
      "description": "Audius handle at grant time"
    },
    "name": {
      "type": "string",
      "description": "Audius display name at grant time"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether Audius reports this account as verified"
    },
    "profile_picture_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "connected",
        "disconnected",
        "invalid"
      ],
      "default": "pending",
      "description": "'pending' is a consent flow that was started but never completed \u2014 kept rather than deleted so the PKCE verifier survives the round trip to Audius. 'invalid' records a grant Audius stopped accepting (revoked by the creator on their side), which is distinct from 'disconnected': one was taken away, the other was given up here."
    },
    "pending_state": {
      "type": "string",
      "description": "CSRF state issued for an in-flight consent request. The callback is rejected unless it returns this value unchanged, which is what stops an attacker's authorization code being planted on this creator's account."
    },
    "pending_code_verifier": {
      "type": "string",
      "description": "PKCE code_verifier for the in-flight request. Held SERVER-SIDE for the whole round trip: keeping it here (rather than in the browser) is what allows the token exchange to happen in a backend function, so the tokens themselves never reach a client."
    },
    "pending_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When consent was requested. Used to expire a stale verifier instead of honouring an authorization code from an abandoned flow."
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "refreshed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful token refresh. Read to decide whether a cached access token is still worth trying before spending a refresh."
    },
    "error_message": {
      "type": "string",
      "description": "Why the grant went invalid, surfaced on the connection card so the creator can reconnect rather than seeing publishing fail with no explanation."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional private note about this connection. Server-side/admin-only like the rest of this entity \u2014 never rendered publicly, so it carries no SEO value, and it must never hold token or key material."
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}