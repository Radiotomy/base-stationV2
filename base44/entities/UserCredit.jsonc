{
  "name": "UserCredit",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Total credits available"
    },
    "lifetime_earned": {
      "type": "number",
      "default": 0
    },
    "lifetime_spent": {
      "type": "number",
      "default": 0
    },
    "monthly_limit": {
      "type": "number",
      "default": 1000
    },
    "monthly_used": {
      "type": "number",
      "default": 0
    },
    "reset_date": {
      "type": "string",
      "format": "date"
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "last_purchase": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for SEO and discoverability"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}