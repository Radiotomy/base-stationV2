{
  "name": "SolanaTrackRegistry",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "artist_email": {
      "type": "string"
    },
    "track_title": {
      "type": "string"
    },
    "track_url": {
      "type": "string"
    },
    "cover_image_url": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "ai_tools_used": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "wallet_address": {
      "type": "string"
    },
    "transaction_signature": {
      "type": "string"
    },
    "metadata_uri": {
      "type": "string"
    },
    "nft_mint_address": {
      "type": "string"
    },
    "registration_status": {
      "type": "string",
      "enum": [
        "pending",
        "registered",
        "failed"
      ],
      "default": "pending"
    },
    "fingerprint_hash": {
      "type": "string",
      "description": "SHA-256 of track metadata for provenance"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "network": {
      "type": "string",
      "default": "devnet"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "artist_id",
    "track_title",
    "wallet_address"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}