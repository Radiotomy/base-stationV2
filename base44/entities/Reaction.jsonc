{
  "name": "Reaction",
  "type": "object",
  "properties": {
    "track_id": {
      "type": "string",
      "description": "ID of the TrackSubmission"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "emoji": {
      "type": "string",
      "description": "Reaction emoji: fire, heart, goat, mind_blown, clap"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for SEO and discoverability"
    }
  },
  "required": [
    "track_id",
    "user_id",
    "emoji"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}