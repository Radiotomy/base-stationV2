{
  "name": "PortalCredential",
  "type": "object",
  "description": "A creator's own Portals access key, enabling hybrid ownership: venues they create are owned by their Portals wallet instead of the platform account. Written and read SERVER-SIDE ONLY \u2014 the key is a bearer credential for the creator's entire Portals account, so RLS denies all client access and backend functions return only a connection status, never the key itself.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "BASE Station creator this credential belongs to"
    },
    "user_email": {
      "type": "string"
    },
    "access_key": {
      "type": "string",
      "description": "The Portals access key. Never returned to any client under any circumstance."
    },
    "portal_uid": {
      "type": "string",
      "description": "Firebase uid Portals reported for this key at verification time. Stored because quest and room-data writes require the owning uid, and re-verifying on every write would waste a round trip."
    },
    "label": {
      "type": "string",
      "description": "Creator-facing nickname for the connection, e.g. 'My Onyx space'"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "invalid"
      ],
      "default": "connected",
      "description": "'invalid' records a key Portals stopped accepting. Disconnecting only affects FUTURE venues \u2014 rooms already created under this key stay creator-owned, so the row is kept rather than deleted."
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "access_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}