{
  "name": "TrackChart",
  "type": "object",
  "properties": {
    "track_title": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "artist_id": {
      "type": "string"
    },
    "artist_slug": {
      "type": "string"
    },
    "cover_image_url": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "genre": {
      "type": "string",
      "enum": [
        "all",
        "hip-hop",
        "edm",
        "pop",
        "r&b",
        "rock",
        "lo-fi",
        "jazz",
        "classical",
        "trap",
        "other"
      ]
    },
    "ai_label": {
      "type": "string",
      "enum": [
        "ai_generated",
        "ai_assisted",
        "human"
      ],
      "description": "RIAA/IFPI GenAI track-level label (July 2026 standard), carried over from the source TrackSubmission. ai_generated = GenAI created the entirety/primary portion of the sound recording; ai_assisted = substantially human recording with some GenAI expressive elements; human = no GenAI in the recording."
    },
    "total_votes": {
      "type": "number",
      "default": 0
    },
    "total_plays": {
      "type": "number",
      "default": 0
    },
    "weekly_votes": {
      "type": "number",
      "default": 0
    },
    "monthly_votes": {
      "type": "number",
      "default": 0
    },
    "chart_rank": {
      "type": "number"
    },
    "previous_rank": {
      "type": "number"
    },
    "rank_change": {
      "type": "number",
      "description": "Positive = moved up, negative = moved down"
    },
    "period": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly",
        "all-time"
      ],
      "default": "weekly"
    },
    "source_session_id": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for SEO and discoverability"
    }
  },
  "required": [
    "track_title",
    "artist_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}