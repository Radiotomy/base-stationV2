{
  "name": "BaseMarkBenchmark",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Groups all attack results measured in one benchmark run"
    },
    "layer": {
      "type": "string",
      "enum": [
        "spectral",
        "neural",
        "drift",
        "speed"
      ],
      "description": "Which BASE Mark layer this measurement is for. spectral = V1 DSP, neural = V2 SilentCipher, drift = V3 WavMark, speed = V4 audiowmark. A drift row records SLOT recovery, not payload recovery \u2014 V3 carries a 16-bit pointer, so 'survived' means the correct slot came back, which the registry then resolves to the asset. A speed row records FULL 32-bit payload recovery, because V4's 128-bit message carries the registry payload whole \u2014 so it is directly comparable to spectral and neural, and not to drift."
    },
    "attack": {
      "type": "string",
      "description": "Stable attack identifier from the ATTACKS registry, e.g. pitch_up_1. The reserved id 'null_unmarked' means NO attack and NO watermark: a null-corpus scan of unmarked audio, measured to establish the false-positive rate. Null rows are the only rows where a detection is a FAILURE."
    },
    "attack_label": {
      "type": "string",
      "description": "Human-readable attack description exactly as measured"
    },
    "trials": {
      "type": "number",
      "default": 1,
      "description": "Number of independent payloads tested for this attack"
    },
    "survived": {
      "type": "number",
      "default": 0,
      "description": "How many trials recovered the correct payload (or, for the drift layer, the correct slot)"
    },
    "survival_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "survived / trials as a percentage \u2014 the measured number. ALWAYS 0 on null_unmarked rows, because there is no payload to recover; read false_positive instead, or a null row will be misread as a failed recovery."
    },
    "mean_strength": {
      "type": "number",
      "description": "Mean detector correlation strength across trials (spectral layer only)"
    },
    "confidence": {
      "type": "number",
      "description": "Mean decoder confidence across trials (drift and speed layers) \u2014 each detector reports its own confidence on its own scale, none of which are comparable to the spectral layer's correlation strength, which is why this is kept in a separate field"
    },
    "bit_error": {
      "type": "number",
      "description": "Speed layer only \u2014 audiowmark's own bit-error estimate for the best pattern line (lower is better). Stored explicitly rather than derived from confidence because the acceptance threshold is defined in bit-error terms, and this is the field the production gate is calibrated from. Absent when the detector returned no pattern line at all."
    },
    "false_positive": {
      "type": "boolean",
      "default": false,
      "description": "True when a scan of audio that carries NO watermark returned a structurally valid payload. On a null_unmarked row this is the entire measurement: the false-positive rate is the count of these over trials. A single true value invalidates the acceptance threshold and forces recalibration, so this is deliberately a first-class field and not a note."
    },
    "detected_speed": {
      "type": "number",
      "description": "Speed layer only \u2014 the playback ratio audiowmark estimated and corrected for before decoding. Comparing this to the attack's true ratio is how we tell a genuine speed recovery from a lucky one"
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "synthetic",
        "uploaded"
      ],
      "default": "synthetic",
      "description": "Test material used"
    },
    "source_class": {
      "type": "string",
      "enum": [
        "ai_generated_wav",
        "human_lossy_preview",
        "human_lossless",
        "synthetic_tone"
      ],
      "description": "Provenance and fidelity class of the null-corpus material, kept separate from source_kind so the false-positive rate can be reported per class instead of as one blended figure nobody can characterize. ai_generated_wav = our own engines, lossless. human_lossy_preview = outside human-produced recordings obtained as lossy previews, so codec damage and human provenance are confounded in that class and it CANNOT be quoted as a clean human-audio figure. human_lossless = outside human-produced lossless masters, the class a published claim actually needs. synthetic_tone = the benchmark's generated test signal."
    },
    "source_seconds": {
      "type": "number",
      "description": "Duration of the source material in seconds. Comparable only within a class: audiowmark gets more evidence from longer audio, so a short row is an easier scan and mixing lengths smears the distribution."
    },
    "sample_rate": {
      "type": "number"
    },
    "cascaded": {
      "type": "boolean",
      "default": false,
      "description": "True when measured on a file carrying MORE THAN ONE layer. A standalone drift row (V3 alone on clean audio) measures WavMark's own robustness; a cascaded row measures it under V1's noise floor, which is the configuration production would actually ship."
    },
    "notes": {
      "type": "string",
      "description": "Caveats for this measurement"
    }
  },
  "required": [
    "run_id",
    "layer",
    "attack",
    "survival_pct"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}