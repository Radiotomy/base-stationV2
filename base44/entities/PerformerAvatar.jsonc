{
  "name": "PerformerAvatar",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "avatarVideoUrl": {
      "type": "string",
      "description": "URL to avatar video or image"
    },
    "trackId": {
      "type": "string",
      "description": "Currently assigned track"
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "ready",
        "performing",
        "offline"
      ],
      "default": "idle"
    },
    "metadata": {
      "type": "object",
      "description": "Flexible avatar metadata (style, mood, etc.)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for SEO and discoverability"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}