{
  "name": "OrvoPodcastAsset",
  "type": "object",
  "description": "ORVO Studio asset (intro/outro stingers, generated voiceovers, artwork). Namespaced to avoid clash with BASE Station UserAsset.",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "podcast_id": {
      "type": "string"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "voiceover",
        "stinger",
        "music_bed",
        "artwork",
        "clip",
        "other"
      ],
      "default": "other"
    },
    "title": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "ipfs_hash": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "metadata": {
      "type": "object",
      "description": "Provider, voice_id, emotion_tags, segment info, etc."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for SEO and discoverability"
    }
  },
  "required": [
    "user_id",
    "asset_type",
    "title",
    "file_url"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}