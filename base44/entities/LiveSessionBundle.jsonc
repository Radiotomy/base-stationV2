{
  "name": "LiveSessionBundle",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "FK to LiveSession"
    },
    "performer_id": {
      "type": "string"
    },
    "performer_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "mixdown_url": {
      "type": "string",
      "description": "Audio mixdown if recording was enabled"
    },
    "event_log_url": {
      "type": "string",
      "description": "JSON file of session events"
    },
    "chat_log_url": {
      "type": "string",
      "description": "JSON file of session chat"
    },
    "metadata": {
      "type": "object",
      "description": "Session stats: duration, peak_viewers, total_reactions, total_messages, top_fans, tracks_used"
    },
    "audius_track_id": {
      "type": "string",
      "description": "Audius track ID once published"
    },
    "audius_publish_status": {
      "type": "string",
      "enum": [
        "pending",
        "success",
        "failed"
      ],
      "description": "Status of publishing this bundle to Audius"
    },
    "audius_publish_error": {
      "type": "string",
      "description": "Error message if Audius publish failed"
    }
  },
  "required": [
    "session_id",
    "performer_id",
    "title"
  ]
}