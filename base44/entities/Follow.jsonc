{
  "name": "Follow",
  "type": "object",
  "properties": {
    "follower_id": {
      "type": "string",
      "description": "User ID of the follower"
    },
    "follower_email": {
      "type": "string"
    },
    "follower_name": {
      "type": "string"
    },
    "follower_avatar_url": {
      "type": "string"
    },
    "following_id": {
      "type": "string",
      "description": "User ID being followed"
    },
    "following_email": {
      "type": "string"
    },
    "following_name": {
      "type": "string"
    },
    "following_avatar_url": {
      "type": "string"
    },
    "following_slug": {
      "type": "string",
      "description": "Artist slug for linking"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for SEO and discoverability"
    }
  },
  "required": [
    "follower_id",
    "following_id"
  ],
  "rls": {
    "create": {
      "data.follower_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.follower_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}