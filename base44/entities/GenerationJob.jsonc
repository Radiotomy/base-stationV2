{
  "name": "GenerationJob",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "music",
        "lyrics",
        "cover_art",
        "video",
        "sfx",
        "loop"
      ],
      "description": "Type of generation task"
    },
    "provider": {
      "type": "string",
      "enum": [
        "loudly",
        "nuro",
        "sonic",
        "producer",
        "tempcolor",
        "ltx",
        "nextcut",
        "shotstack",
        "elevenlabs",
        "harmonix",
        "sirensong",
        "skye",
        "soundforge",
        "sever",
        "core",
        "maestro"
      ],
      "description": "Which provider handled the generation. 'nextcut' is retired and kept only for historical rows \u2014 video composition now runs on 'shotstack'. 'core' = the platform's own LLM wrote the lyrics inline. 'sirensong' = Siren Song (HeartMuLa 3B) audio generation on our self-hosted Hugging Face Space engine; the row is created 'processing' at submit and finalized to 'completed' by pollSirenSongJob once the L4 GPU render is fetched and persisted. 'skye' = Skye, our open-source fork of DiffRhythm 2, self-hosted on its own Hugging Face Space; same submit-and-poll lifecycle as sirensong (finalized by pollSkyeJob) but a different model with prose style + negative prompt + optional reference-audio style cloning, and long-form output up to 285s. 'sever' = Sever, our self-hosted HTDemucs-6s stem separation engine; it REPLACES 'tempcolor' for separation, so a tempcolor separation row is historical. Sever rows are separation work, never generation \u2014 the stems inherit the source's GenAI label rather than being labelled as newly generated audio. 'maestro' = the row is a WORK ORDER for the Maestro Superagent's craft engine: it is created 'pending' with nothing generated yet, and the Maestro sweep is what fills output_metadata and flips it to 'completed'. Nothing else may complete a maestro row, otherwise the craft engine would be silently bypassed."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "pending"
    },
    "ai_label": {
      "type": "string",
      "enum": [
        "ai_generated",
        "ai_assisted",
        "human"
      ],
      "description": "RIAA/IFPI GenAI track-level label (July 2026 standard). ai_generated = GenAI created the entirety/primary portion of the sound recording; ai_assisted = substantially human recording with some GenAI expressive elements; human = no GenAI in the recording. Applies to sound recordings only (not lyrics/cover art/video)."
    },
    "input_data": {
      "type": "object",
      "description": "Generation parameters (mood, genre, duration, etc.). For a maestro lyrics work order this is the full brief the craft engine reads: topic, genre, mood, bpm, duration, title and the draft sound_prompt."
    },
    "output_url": {
      "type": "string",
      "description": "URL to generated file"
    },
    "output_metadata": {
      "type": "object",
      "description": "BPM, key, duration, etc. For a completed maestro lyrics job this carries the mastercraft results the music job is then built from: 'lyrics' (the enhanced lyric) and 'sound_prompt' (the production-optimized style brief)."
    },
    "credits_used": {
      "type": "number",
      "default": 0
    },
    "error_message": {
      "type": "string"
    },
    "provider_job_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for SEO and discoverability"
    }
  },
  "required": [
    "user_id",
    "job_type",
    "provider"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}