{
  "name": "PlaylistTrack",
  "type": "object",
  "properties": {
    "playlist_id": {
      "type": "string",
      "description": "Parent playlist ID"
    },
    "track_title": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "artist_id": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "cover_image_url": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "genre": {
      "type": "string"
    },
    "position": {
      "type": "number",
      "description": "Order within playlist"
    },
    "play_count": {
      "type": "number",
      "default": 0
    },
    "vote_count": {
      "type": "number",
      "default": 0
    },
    "source_type": {
      "type": "string",
      "enum": [
        "upload",
        "session",
        "external"
      ],
      "default": "upload"
    },
    "source_id": {
      "type": "string",
      "description": "Reference to original session/submission ID"
    },
    "audius_track_id": {
      "type": "string",
      "description": "The track's Audius release, when it has one. Only ever written from a release Audius actually confirmed."
    },
    "audius_permalink": {
      "type": "string",
      "description": "Public audius.co URL for the release. Convenience cache \u2014 audius_track_id stays the record."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for SEO and discoverability"
    }
  },
  "required": [
    "playlist_id",
    "track_title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}