{
  "name": "RadioChannel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Channel name e.g. 'Hip-Hop Vibes'"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe identifier"
    },
    "description": {
      "type": "string"
    },
    "genre": {
      "type": "string",
      "enum": [
        "discover",
        "staff-picks",
        "hip-hop",
        "edm",
        "r&b",
        "rock",
        "lo-fi",
        "pop",
        "trap",
        "jazz",
        "all"
      ]
    },
    "cover_image_url": {
      "type": "string"
    },
    "stream_url": {
      "type": "string",
      "description": "Live stream or playlist URL"
    },
    "is_live": {
      "type": "boolean",
      "default": false
    },
    "listener_count": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "color_theme": {
      "type": "string",
      "description": "Hex color for channel branding"
    },
    "emoji": {
      "type": "string",
      "description": "Channel emoji icon"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "slug",
    "genre"
  ]
}