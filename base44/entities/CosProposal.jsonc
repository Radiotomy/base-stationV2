{
  "name": "CosProposal",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Proposal author"
    },
    "user_name": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Short proposal title"
    },
    "description": {
      "type": "string",
      "description": "Rationale \u2014 why this weight or rule should change"
    },
    "signal_key": {
      "type": "string",
      "enum": [
        "own_content",
        "detailed_prompt",
        "reference_upload",
        "persona_preset",
        "style_selection",
        "iteration",
        "new_signal"
      ],
      "description": "Which COS scoring signal the proposal targets. new_signal = proposing a brand-new signal"
    },
    "current_weight": {
      "type": "number",
      "description": "Current point value of the signal (0 if new_signal)"
    },
    "proposed_weight": {
      "type": "number",
      "description": "Proposed point value"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "under_review",
        "adopted",
        "declined"
      ],
      "default": "open",
      "description": "Governance lifecycle. Admins move proposals out of open based on community consensus"
    }
  },
  "required": [
    "user_id",
    "title",
    "signal_key",
    "proposed_weight"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}