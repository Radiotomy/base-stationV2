{
  "name": "LiveChatMessage",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "roomId": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "userName": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "messageType": {
      "type": "string",
      "enum": [
        "chat",
        "reaction",
        "system",
        "event"
      ],
      "default": "chat"
    },
    "type": {
      "type": "string",
      "enum": [
        "chat",
        "reaction",
        "tip",
        "system"
      ],
      "default": "chat"
    },
    "emoji": {
      "type": "string",
      "description": "For reaction type messages"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for SEO and discoverability"
    }
  },
  "required": [
    "session_id",
    "user_id",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}