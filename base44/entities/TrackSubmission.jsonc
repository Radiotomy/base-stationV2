{
  "name": "TrackSubmission",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "artist_email": {
      "type": "string"
    },
    "artist_avatar_url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "track_url": {
      "type": "string"
    },
    "cover_image_url": {
      "type": "string"
    },
    "genre": {
      "type": "string",
      "enum": [
        "hip-hop",
        "edm",
        "pop",
        "r&b",
        "rock",
        "lo-fi",
        "jazz",
        "classical",
        "trap",
        "other"
      ]
    },
    "ai_tools_used": {
      "type": "string"
    },
    "ai_label": {
      "type": "string",
      "enum": [
        "ai_generated",
        "ai_assisted",
        "human"
      ],
      "description": "RIAA/IFPI GenAI track-level label (July 2026 standard), self-declared by the artist at submission. ai_generated = GenAI created the entirety/primary portion of the sound recording; ai_assisted = substantially human recording with some GenAI expressive elements; human = no GenAI in the recording."
    },
    "source_check": {
      "type": "object",
      "description": "External link source verification result \u2014 verified flag, source_name (Suno, YouTube, etc.), method, checked_at, reason if failed"
    },
    "ai_analysis": {
      "type": "object",
      "description": "Heuristic AI-involvement audio analysis for uploaded files \u2014 ai_likelihood 0-100, verdict, indicators, label_consistency vs the declared ai_label, summary"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duration_seconds": {
      "type": "number"
    },
    "play_count": {
      "type": "number",
      "default": 0
    },
    "like_count": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "lyrics": {
      "type": "string"
    },
    "bpm": {
      "type": "number"
    },
    "key": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "artist_name",
    "track_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.artist_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}