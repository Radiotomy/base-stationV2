{
  "name": "LiveSession",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "streaming",
        "completed",
        "archived"
      ],
      "default": "draft"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number"
    },
    "stream_url": {
      "type": "string"
    },
    "viewer_count": {
      "type": "number",
      "default": 0
    },
    "peak_viewers": {
      "type": "number",
      "default": 0
    },
    "tracks_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_track_title": {
      "type": "string",
      "description": "Currently playing track title (synced to fan watch page)"
    },
    "current_track_artist": {
      "type": "string",
      "description": "Currently playing track artist"
    },
    "portal_room_id": {
      "type": "string",
      "description": "The Portal 3D room ID for the fan watch stage"
    },
    "output_url": {
      "type": "string"
    },
    "recording_enabled": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "type": "object",
      "description": "Audiograph-style synchronized event state",
      "properties": {
        "nowPlaying": {
          "type": "object",
          "properties": {
            "trackId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "position": {
              "type": "number"
            },
            "isPlaying": {
              "type": "boolean"
            }
          }
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "performer",
                  "fan",
                  "agent"
                ]
              },
              "avatarUrl": {
                "type": "string"
              }
            }
          }
        },
        "recentEvents": {
          "type": "array",
          "description": "Audiograph event bus \u2014 last 20 events",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "payload": {
                "type": "object"
              },
              "timestamp": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "user_id",
    "title"
  ]
}