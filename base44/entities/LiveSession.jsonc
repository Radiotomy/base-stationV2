{
  "name": "LiveSession",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "streaming",
        "completed",
        "archived"
      ],
      "default": "draft"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number"
    },
    "stream_url": {
      "type": "string"
    },
    "viewer_count": {
      "type": "number",
      "default": 0
    },
    "peak_viewers": {
      "type": "number",
      "default": 0
    },
    "tracks_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_track_title": {
      "type": "string",
      "description": "Currently playing track title (synced to fan watch page)"
    },
    "current_track_artist": {
      "type": "string",
      "description": "Currently playing track artist"
    },
    "portal_room_id": {
      "type": "string",
      "description": "The Portal 3D room ID for the fan watch stage"
    },
    "portals_room_id": {
      "type": "string",
      "description": "Phase 4: Portals 3D venue room id (alias for newer Portals integration)"
    },
    "portals_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Phase 4: Whether the 3D Portals venue is enabled"
    },
    "portals_scene": {
      "type": "string",
      "enum": [
        "club",
        "arena",
        "studio",
        "void"
      ],
      "description": "Phase 4: 3D scene preset"
    },
    "streamr_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Phase 4: Whether live audio transport via Streamr is enabled"
    },
    "streamr_stream_id": {
      "type": "string",
      "description": "Phase 4: Streamr stream id for live audio"
    },
    "ai_cohost_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Phase 4: Whether the AI co-host agent is active"
    },
    "active_visualizer_preset_id": {
      "type": "string",
      "description": "Phase 4: Selected LiveVisualPreset id"
    },
    "audio_reactive_visuals": {
      "type": "boolean",
      "default": false,
      "description": "Phase 4: Audio-reactive visualizer mode"
    },
    "live_drops_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Phase 5: Whether live collectible drops are enabled"
    },
    "active_drop_id": {
      "type": "string",
      "description": "Phase 5: Currently active Collectible drop id"
    },
    "output_url": {
      "type": "string"
    },
    "recording_enabled": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "type": "object",
      "description": "Audiograph-style synchronized event state",
      "properties": {
        "nowPlaying": {
          "type": "object",
          "properties": {
            "trackId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "position": {
              "type": "number"
            },
            "isPlaying": {
              "type": "boolean"
            }
          }
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "performer",
                  "fan",
                  "agent"
                ]
              },
              "role": {
                "type": "string",
                "enum": [
                  "performer",
                  "co-performer",
                  "fan",
                  "agent"
                ],
                "description": "Phase 4: Granular role"
              },
              "is_live": {
                "type": "boolean",
                "description": "Phase 4: Whether participant is currently live"
              },
              "avatar_state": {
                "type": "object",
                "description": "Phase 4: Avatar pose / mood / props"
              },
              "avatarUrl": {
                "type": "string"
              }
            }
          }
        },
        "recentEvents": {
          "type": "array",
          "description": "Audiograph event bus \u2014 last 20 events",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "payload": {
                "type": "object"
              },
              "timestamp": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "user_id",
    "title"
  ]
}