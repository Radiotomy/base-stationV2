{
  "name": "ForumMember",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "description": "Public name shown on forum posts"
    },
    "email": {
      "type": "string",
      "description": "Optional contact email (never shown publicly)"
    },
    "source": {
      "type": "string",
      "enum": [
        "guest",
        "member"
      ],
      "default": "guest",
      "description": "guest = standalone forum registration; member = BASE Station account holder"
    },
    "user_id": {
      "type": "string",
      "description": "Linked BASE Station user id when source=member"
    },
    "token": {
      "type": "string",
      "description": "Guest session token used to authenticate guest posts (server-side only)"
    }
  },
  "required": [
    "display_name",
    "source"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}