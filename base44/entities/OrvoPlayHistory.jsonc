{
  "name": "OrvoPlayHistory",
  "type": "object",
  "description": "ORVO per-listener resume position for an episode.",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "episode_id": {
      "type": "string"
    },
    "podcast_id": {
      "type": "string"
    },
    "position_seconds": {
      "type": "number",
      "default": 0
    },
    "completed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "episode_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}