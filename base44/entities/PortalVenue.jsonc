{
  "name": "PortalVenue",
  "type": "object",
  "description": "A creator's 3D live venue, hosted on Portals (theportal.to) but created, branded and managed entirely from BASE Station's Live Studio. Deliberately separate from LiveSession: a venue is a durable, reusable place, while a session is one performance that happens inside it. One venue can host many sessions, so the room is never rebuilt per show.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Creator who owns this venue inside BASE Station"
    },
    "user_email": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Venue name, shown in the dashboard and pushed to the Portals room name"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "room_id": {
      "type": "string",
      "description": "Portals room id. The single link between a BASE Station venue and the 3D world it renders; without it the venue card has nothing to embed."
    },
    "template_key": {
      "type": "string",
      "description": "The performance preset currently applied (festival_stage, electronic_club, intimate_acoustic, jazz_lounge, hiphop_arena, pop_showcase, country_barn, tropical_outdoor). Rewritten whenever the artist switches template, because a preset switch changes the room's actual scene in place \u2014 this field is what the Templates tab reads to show which world is live."
    },
    "cover_image_url": {
      "type": "string",
      "description": "Branded cover, used as the venue card art and as the Portals room image"
    },
    "ownership": {
      "type": "string",
      "enum": [
        "platform",
        "creator"
      ],
      "default": "platform",
      "description": "Which Portals account owns the underlying room. 'platform' = provisioned under BASE Station's account (no Portals account needed). 'creator' = created with the creator's own connected access key, so their wallet owns it. This is fixed at creation time and never rewritten: the room can only ever be modified with the key that made it."
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "unlisted",
        "private"
      ],
      "default": "unlisted",
      "description": "Who may find and enter this venue from BASE Station. 'public' = listed in the public venue directory and open to anyone. 'unlisted' = fully playable but only reachable with the direct link, so a creator can share a room before announcing it. 'private' = the public venue page refuses to serve it at all. Defaults to 'unlisted' deliberately: a venue must be opted IN to a public directory by its creator, never swept in by a platform feature launched after it was built. Note the underlying Portals room has its own access settings \u2014 this field governs BASE Station surfaces only."
    },
    "status": {
      "type": "string",
      "enum": [
        "creating",
        "ready",
        "failed",
        "archived"
      ],
      "default": "creating",
      "description": "'creating' covers the window where Portals has been asked for a room but has not returned one. A venue in 'failed' keeps its row so the creator sees what went wrong instead of the venue silently vanishing."
    },
    "error_message": {
      "type": "string",
      "description": "Why creation failed, surfaced to the creator on the venue card"
    },
    "welcome_embed_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the BASE Station in-world panel (now playing, provenance, tip jar, quests) is wired to this room's welcome iframe."
    },
    "idle_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this venue runs idle programming \u2014 a looping audio + video playlist that keeps the room alive whenever the artist is NOT live. When false the venue falls back to its static cover art, which is what an unprogrammed venue looked like before idle content existed."
    },
    "idle_now_playing": {
      "type": "object",
      "description": "Snapshot of what the stage was last pushed, written by the idle driver. This is a CACHE for change detection and for surfaces that cannot compute the clock themselves \u2014 it is never the source of truth. Position always comes from the playlist's cycle origin, so a stale snapshot can misreport the title but can never desynchronise playback."
    },
    "idle_last_pushed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the stage screen was last rewritten. Kept so the driver can avoid re-uploading a whole Portals room on every tick when nothing has actually changed \u2014 a room upload replaces the entire room, so needless writes are the main risk to anything the artist placed by hand."
    },
    "settings_snapshot": {
      "type": "object",
      "description": "The last settings patch BASE Station applied, captured BEFORE the write. Kept so a creator can revert a design or template change from BASE Station without hunting through Portals' own version history."
    },
    "last_published_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "name"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}