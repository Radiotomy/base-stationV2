{
  "name": "AnalyticsEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "generation_started",
        "generation_completed",
        "generation_failed",
        "session_started",
        "session_ended",
        "track_submitted",
        "track_downloaded",
        "effect_applied",
        "studio_visit",
        "live_session_started",
        "live_session_ended",
        "live_track_play",
        "live_track_pause",
        "live_track_seek",
        "live_reaction",
        "live_chat_message",
        "live_participant_join",
        "live_participant_leave",
        "live_scene_change",
        "live_performer_ready",
        "live_performer_start"
      ]
    },
    "event_data": {
      "type": "object",
      "description": "Flexible event metadata"
    },
    "session_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "duration_ms": {
      "type": "number"
    },
    "provider": {
      "type": "string"
    },
    "credits_used": {
      "type": "number"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for SEO and discoverability"
    }
  },
  "required": [
    "user_id",
    "event_type"
  ]
}