{
  "name": "BaseTrackRegistry",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "artist_email": {
      "type": "string"
    },
    "track_title": {
      "type": "string"
    },
    "track_url": {
      "type": "string"
    },
    "cover_image_url": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "ai_tools_used": {
      "type": "string"
    },
    "ai_label": {
      "type": "string",
      "enum": [
        "ai_generated",
        "ai_assisted",
        "human",
        "unverified"
      ],
      "description": "RIAA/IFPI GenAI track-level label (July 2026 standard) embedded in the on-chain provenance record. ai_generated = GenAI created the entirety/primary portion of the sound recording; ai_assisted = substantially human recording with some GenAI expressive elements; human = no GenAI in the recording; unverified = origin never declared and no AI use observed."
    },
    "description": {
      "type": "string"
    },
    "wallet_address": {
      "type": "string",
      "description": "Base EVM wallet address"
    },
    "transaction_hash": {
      "type": "string",
      "description": "Base network transaction hash"
    },
    "metadata_uri": {
      "type": "string",
      "description": "IPFS or metadata URI"
    },
    "contract_address": {
      "type": "string",
      "description": "NFT or registry contract address on Base"
    },
    "registration_status": {
      "type": "string",
      "enum": [
        "pending",
        "registered",
        "failed"
      ],
      "default": "pending"
    },
    "fingerprint_hash": {
      "type": "string",
      "description": "SHA-256 of track metadata for provenance"
    },
    "composition_hash": {
      "type": "string",
      "description": "SHA-256 composition footprint (key, chord intervals, structural boundaries) from a SheetSage2 transcription of the asset, carried in the anchor calldata as `score:<hash>`. Absent when the track was never transcribed before anchoring \u2014 calldata is immutable, so a later transcription is not back-filled into an existing anchor."
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "network": {
      "type": "string",
      "default": "base-mainnet"
    },
    "supersedes_tx_hash": {
      "type": "string",
      "description": "Transaction hash of an earlier anchor that this record corrects. A blockchain anchor cannot be edited or deleted, so a bad anchor is remedied by publishing a correction anchor that explicitly names the transaction it supersedes. Present only on correction records."
    },
    "superseded_by_tx_hash": {
      "type": "string",
      "description": "Set on the ORIGINAL record once a correction anchor replaces it, so anyone reading the old anchor is led to the authoritative one."
    },
    "correction_reason": {
      "type": "string",
      "description": "Why this correction anchor was published"
    },
    "audius_track_id": {
      "type": "string",
      "description": "The Audius release this anchor covers, when one exists. Half of the Audius \u2194 chain bridge: it lets a reader who arrives at the on-chain anchor resolve the live release, and a reader who arrives from Audius verify the recording against a Base transaction. Read `audius_link_basis` before trusting it as an on-chain fact \u2014 the same value means two different strengths of claim depending on when it was written."
    },
    "audius_permalink": {
      "type": "string",
      "description": "Public audius.co URL for the linked release. A CONVENIENCE CACHE only: Audius rewrites the slug when a track is renamed, so audius_track_id stays the record of the release."
    },
    "audius_link_basis": {
      "type": "string",
      "enum": [
        "in_calldata",
        "off_chain_backlink"
      ],
      "description": "How strong the Audius link actually is, recorded because the two cases are indistinguishable once written and must never be conflated. 'in_calldata' = the track was already published when this anchor was broadcast, so the id is INSIDE the signed transaction and is provable on-chain. 'off_chain_backlink' = the anchor predates the release, so calldata could not name it and this database row is the only thing asserting the pairing. Calldata is immutable, so a back-link is never upgraded in place \u2014 the weaker claim stays honestly labelled as the weaker claim."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "artist_id",
    "track_title",
    "wallet_address"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}