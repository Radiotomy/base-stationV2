{
  "name": "BaseTrackRegistry",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "artist_email": {
      "type": "string"
    },
    "track_title": {
      "type": "string"
    },
    "track_url": {
      "type": "string"
    },
    "cover_image_url": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "ai_tools_used": {
      "type": "string"
    },
    "ai_label": {
      "type": "string",
      "enum": [
        "ai_generated",
        "ai_assisted",
        "human",
        "unverified"
      ],
      "description": "RIAA/IFPI GenAI track-level label (July 2026 standard) embedded in the on-chain provenance record. ai_generated = GenAI created the entirety/primary portion of the sound recording; ai_assisted = substantially human recording with some GenAI expressive elements; human = no GenAI in the recording; unverified = origin never declared and no AI use observed."
    },
    "description": {
      "type": "string"
    },
    "wallet_address": {
      "type": "string",
      "description": "Base EVM wallet address"
    },
    "transaction_hash": {
      "type": "string",
      "description": "Base network transaction hash"
    },
    "metadata_uri": {
      "type": "string",
      "description": "IPFS or metadata URI"
    },
    "contract_address": {
      "type": "string",
      "description": "NFT or registry contract address on Base"
    },
    "registration_status": {
      "type": "string",
      "enum": [
        "pending",
        "registered",
        "failed"
      ],
      "default": "pending"
    },
    "fingerprint_hash": {
      "type": "string",
      "description": "SHA-256 of track metadata for provenance"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "network": {
      "type": "string",
      "default": "base-mainnet"
    },
    "supersedes_tx_hash": {
      "type": "string",
      "description": "Transaction hash of an earlier anchor that this record corrects. A blockchain anchor cannot be edited or deleted, so a bad anchor is remedied by publishing a correction anchor that explicitly names the transaction it supersedes. Present only on correction records."
    },
    "superseded_by_tx_hash": {
      "type": "string",
      "description": "Set on the ORIGINAL record once a correction anchor replaces it, so anyone reading the old anchor is led to the authoritative one."
    },
    "correction_reason": {
      "type": "string",
      "description": "Why this correction anchor was published"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "artist_id",
    "track_title",
    "wallet_address"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}