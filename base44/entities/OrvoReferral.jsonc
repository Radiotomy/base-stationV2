{
  "name": "OrvoReferral",
  "type": "object",
  "description": "ORVO creator referral \u2014 invite another creator to ORVO Studio.",
  "properties": {
    "referrer_id": {
      "type": "string"
    },
    "referred_email": {
      "type": "string"
    },
    "referred_user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "joined",
        "rewarded"
      ],
      "default": "sent"
    }
  },
  "required": [
    "referrer_id",
    "referred_email"
  ],
  "rls": {
    "create": {
      "data.referrer_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.referrer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.referrer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}