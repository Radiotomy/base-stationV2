{
  "name": "ArtistProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly unique identifier"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "social_links": {
      "type": "object"
    },
    "ai_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "track_count": {
      "type": "number",
      "default": 0
    },
    "follower_count": {
      "type": "number",
      "default": 0
    },
    "following_count": {
      "type": "number",
      "default": 0
    },
    "total_plays": {
      "type": "number",
      "default": 0
    },
    "total_tips_received_cents": {
      "type": "number",
      "default": 0
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "is_public": {
      "type": "boolean",
      "default": true
    },
    "tipping_enabled": {
      "type": "boolean",
      "default": true
    },
    "tip_wallets": {
      "type": "object",
      "description": "Artist-owned receiving addresses for non-custodial tips. Public by design \u2014 fans send directly to these.",
      "properties": {
        "base": {
          "type": "string",
          "description": "Base (EVM) address, 0x\u2026"
        },
        "solana": {
          "type": "string",
          "description": "Solana address (base58)"
        },
        "audius_handle": {
          "type": "string",
          "description": "Audius handle for native $AUDIO tipping"
        }
      }
    }
  },
  "required": [
    "user_id",
    "display_name"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}