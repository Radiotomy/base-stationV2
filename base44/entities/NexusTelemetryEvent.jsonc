{
  "name": "NexusTelemetryEvent",
  "type": "object",
  "description": "One AI invocation made through the Audiotool Bridge inside a live Nexus session. Stored ONLY in BASE Station's own database (never in the browser, never forwarded to any third party or data broker) to comply with Audiotool's API User Data Policy. Private to the creator; read by the COS engine to split human vs machine contribution.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Creator whose session this invocation happened in"
    },
    "project_url": {
      "type": "string",
      "description": "Audiotool project link the invocation wrote into"
    },
    "tool": {
      "type": "string",
      "enum": [
        "midi_coproducer",
        "instrument_chain",
        "songstarter_loop",
        "songstarter_sfx",
        "library_ai_sample",
        "drum_generator",
        "bassline_generator",
        "tonematrix_generator"
      ],
      "description": "Which bridge AI tool was invoked. songstarter_loop = BASE Forge loop sent to the timeline; songstarter_sfx = ElevenLabs sound effect sent to the timeline; library_ai_sample = an AI-generated library loop sent to the timeline; drum_generator = an AI-written Beatbox 8 pattern; bassline_generator = an AI-written Bassline pattern; tonematrix_generator = an AI-written Tonematrix pattern. A pattern the creator tapped in by hand is never logged here, so it counts as human."
    },
    "prompt": {
      "type": "string",
      "maxLength": 500,
      "description": "The creator's direction, truncated"
    },
    "collection_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nexus note collections the AI wrote"
    },
    "device_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nexus devices the AI created (including audio devices holding AI-generated samples)"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional private note"
    }
  },
  "required": [
    "user_id",
    "project_url",
    "tool"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}