{
  "name": "User",
  "type": "object",
  "properties": {
    "onboarding_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has finished the 3-step onboarding tour"
    },
    "tour_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has finished the first-run guided spotlight tour"
    },
    "beta_access": {
      "type": "boolean",
      "default": false,
      "description": "Admin-granted access to beta studios (Video Studio, Live Studio)"
    },
    "training_opt_in": {
      "type": "boolean",
      "default": false,
      "description": "User has explicitly agreed to let their prompts, settings and ratings improve BASE-Harmonix. Defaults to false \u2014 consent must be given, never assumed. No audio is ever collected under this flag."
    },
    "training_opt_in_date": {
      "type": "string",
      "format": "date-time",
      "description": "When consent was given. Needed to prove which consent version applied at collection time."
    },
    "is_suspended": {
      "type": "boolean",
      "default": false,
      "description": "Admin-set account suspension. A suspended user stays signed in but is blocked from every app surface until an admin lifts it."
    },
    "suspension_reason": {
      "type": "string",
      "description": "Reason shown to the suspended user and recorded for the admin audit trail"
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the suspension was applied"
    }
  },
  "required": []
}