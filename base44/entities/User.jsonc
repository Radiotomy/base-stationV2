{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "description": "The role of the user in the app"
    },
    "is_creator": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has creator/artist privileges"
    }
  },
  "required": [
    "role"
  ]
}