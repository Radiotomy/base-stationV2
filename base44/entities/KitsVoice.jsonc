{
  "name": "KitsVoice",
  "type": "object",
  "description": "A Kits.ai voice model usable for conversion, harmony and lead-vocal renders. Platform rows are the royalty-free Kits library cached server-side; personal rows are a creator's own cloned voice (trained on Kits and pasted back by id) or a voice they blended here.",
  "properties": {
    "model_id": {
      "type": "string",
      "description": "Kits voiceModelId"
    },
    "title": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image_url": {
      "type": "string"
    },
    "demo_url": {
      "type": "string"
    },
    "is_platform": {
      "type": "boolean",
      "default": false,
      "description": "Royalty-free Kits library voice, visible to everyone"
    },
    "user_id": {
      "type": "string",
      "description": "Owner of a personal (clone/blend) voice"
    },
    "source": {
      "type": "string",
      "enum": [
        "library",
        "clone",
        "blend"
      ],
      "default": "library"
    },
    "is_usable": {
      "type": "boolean",
      "default": true,
      "description": "False while a blend is still being built on Kits"
    },
    "blend_job_id": {
      "type": "string",
      "description": "GenerationJob that produced this blended voice"
    },
    "blend_inputs": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "[{model_id, title, alpha}] for a blended voice"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "model_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.is_platform": true
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}