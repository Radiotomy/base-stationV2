{
  "name": "VoicePersona",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of persona owner"
    },
    "user_email": {
      "type": "string",
      "description": "Email of persona owner"
    },
    "name": {
      "type": "string",
      "description": "Persona name (e.g., 'Jazz Singer', 'Rap MC')"
    },
    "description": {
      "type": "string",
      "description": "Detailed persona description"
    },
    "voice_type": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "neutral"
      ],
      "description": "Voice gender type"
    },
    "age": {
      "type": "string",
      "enum": [
        "child",
        "teen",
        "adult",
        "senior"
      ],
      "description": "Apparent age of voice"
    },
    "accent": {
      "type": "string",
      "enum": [
        "american",
        "british",
        "australian",
        "neutral",
        "other"
      ],
      "description": "Voice accent type"
    },
    "characteristics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Voice traits (e.g., 'raspy', 'breathy', 'monotone')"
    },
    "sample_url": {
      "type": "string",
      "description": "URL to voice sample audio"
    },
    "provider": {
      "type": "string",
      "enum": [
        "sonic",
        "elevenlabs",
        "inworld",
        "google",
        "azure",
        "custom"
      ],
      "description": "Voice synthesis provider. 'sonic' = cloned via Sonic create-voice, usable in persona_music generation. 'inworld' = Inworld TTS character voices, the same engine ORVO's voiceovers and AI-cast shows use."
    },
    "provider_voice_id": {
      "type": "string",
      "description": "Provider's unique voice ID (Sonic persona_id for provider='sonic', Inworld voice name for provider='inworld')"
    },
    "source_asset_id": {
      "type": "string",
      "description": "UserAsset id the voice was cloned from (track/stem), if any"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Search and organization tags"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "usage_count": {
      "type": "number",
      "default": 0,
      "description": "Number of tracks using this voice"
    }
  },
  "required": [
    "user_id",
    "name",
    "voice_type",
    "provider"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}