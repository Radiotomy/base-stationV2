{
  "name": "Challenge",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly",
        "special"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "music",
        "patch_design"
      ],
      "default": "music",
      "description": "What is being judged. 'music' = a sound recording entry. 'patch_design' = a BASE Foundry DSP patch, judged on the graph the human designed rather than on audio \u2014 so a patch challenge entry carries a plugin, never a track URL."
    },
    "genre": {
      "type": "string"
    },
    "prompt": {
      "type": "string",
      "description": "Creative prompt for the challenge"
    },
    "prize_description": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "voting",
        "completed"
      ],
      "default": "upcoming"
    },
    "cover_image_url": {
      "type": "string"
    },
    "submission_count": {
      "type": "number",
      "default": 0
    },
    "max_submissions": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emoji": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}