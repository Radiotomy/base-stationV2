{
  "name": "LoopSample",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Uploader/owner id"
    },
    "user_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "loop",
        "one_shot",
        "drum_loop",
        "bass_loop",
        "melodic_loop",
        "vocal_chop",
        "fx",
        "sample"
      ],
      "default": "loop"
    },
    "source": {
      "type": "string",
      "enum": [
        "upload",
        "freesound",
        "admin_collection",
        "soundforge"
      ],
      "default": "upload"
    },
    "bpm": {
      "type": "number"
    },
    "key": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "collection_name": {
      "type": "string",
      "description": "Batch/collection grouping, e.g. 'CD Vol 1' or a Freesound pack name"
    },
    "license": {
      "type": "string",
      "description": "e.g. CC0, CC-BY, User Upload"
    },
    "attribution": {
      "type": "string",
      "description": "Required credit text for CC-BY sourced content"
    },
    "external_id": {
      "type": "string",
      "description": "Freesound sound id when source=freesound"
    },
    "external_url": {
      "type": "string",
      "description": "Link back to the original source page"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Visible in the shared community loop library"
    },
    "loop_spec": {
      "type": "object",
      "description": "What the SoundForge finishing stage measured and applied \u2014 seamless flag, bar/beat count, sample rate, bit depth, normalization. Stored so the library can show DAW-readiness without re-analyzing the file."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for SEO and discoverability"
    }
  },
  "required": [
    "title",
    "file_url"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.is_public": true
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}