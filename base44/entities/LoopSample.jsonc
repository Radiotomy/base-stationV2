{
  "name": "LoopSample",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Uploader/owner id"
    },
    "user_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "loop",
        "one_shot",
        "drum_loop",
        "bass_loop",
        "melodic_loop",
        "vocal_chop",
        "fx",
        "sample"
      ],
      "default": "loop"
    },
    "source": {
      "type": "string",
      "enum": [
        "upload",
        "freesound",
        "admin_collection",
        "soundforge"
      ],
      "default": "upload"
    },
    "bpm": {
      "type": "number"
    },
    "key": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "collection_name": {
      "type": "string",
      "description": "Batch/collection grouping, e.g. 'CD Vol 1' or a Freesound pack name"
    },
    "license": {
      "type": "string",
      "description": "e.g. CC0, CC-BY, User Upload"
    },
    "attribution": {
      "type": "string",
      "description": "Required credit text for CC-BY sourced content"
    },
    "external_id": {
      "type": "string",
      "description": "Freesound sound id when source=freesound"
    },
    "external_url": {
      "type": "string",
      "description": "Link back to the original source page"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Visible in the shared community loop library"
    },
    "loop_spec": {
      "type": "object",
      "description": "What the SoundForge finishing stage measured and applied \u2014 seamless flag, bar/beat count, sample rate, bit depth, normalization. Stored so the library can show DAW-readiness without re-analyzing the file."
    },
    "base_mark_asset_id": {
      "type": "string",
      "description": "UserAsset id carrying this loop's BASE Mark cascade. A loop is a LoopSample, but the forensic registry is indexed on UserAsset \u2014 a payload that resolves to nothing is discarded as a false positive, so a loop can only be attributable if it also owns a registry row. Same arrangement ORVO episodes use: the asset IS the provenance record, the loop points at it."
    },
    "provenance_status": {
      "type": "string",
      "enum": [
        "unregistered",
        "processing",
        "marked",
        "failed"
      ],
      "default": "unregistered",
      "description": "BASE Mark registration state for this loop's audio. Only generated loops are registered \u2014 an imported CC0 sample is somebody else's recording and must never be marked as this creator's work."
    },
    "clap_embedding": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "512-d L2-normalized CLAP audio embedding used for semantic ('sounds like\u2026') search. Normalized at the source so similarity is a plain dot product. Deliberately NOT a forensic signal: an embedding describes what a sound resembles, never who owns it, so it must never be read as provenance the way a BASE Mark payload or a BASE Print match is."
    },
    "clap_model": {
      "type": "string",
      "description": "Checkpoint the embedding came from. Load-bearing: embeddings from two different CLAP checkpoints are NOT comparable, so a stored vector is meaningless without knowing its model, and a checkpoint change means re-embedding rather than mixing."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for SEO and discoverability"
    }
  },
  "required": [
    "title",
    "file_url"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.is_public": true
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}