{
  "name": "OrvoCollaboration",
  "type": "object",
  "description": "ORVO async collaboration invite \u2014 co-host/guest access to a podcast project (activated Phase 5).",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "Podcast owner who sent the invite"
    },
    "podcast_id": {
      "type": "string"
    },
    "collaborator_email": {
      "type": "string"
    },
    "collaborator_user_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "co_host",
        "guest",
        "editor"
      ],
      "default": "guest"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "revoked"
      ],
      "default": "pending"
    },
    "guest_link_token": {
      "type": "string",
      "description": "Token for the public guest recording route"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for SEO and discoverability"
    }
  },
  "required": [
    "owner_id",
    "podcast_id",
    "collaborator_email"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.collaborator_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.collaborator_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}