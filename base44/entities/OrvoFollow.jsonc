{
  "name": "OrvoFollow",
  "type": "object",
  "description": "ORVO follow relationship: listener follows a podcast. Namespaced to avoid clash with BASE Station Follow.",
  "properties": {
    "follower_id": {
      "type": "string"
    },
    "podcast_id": {
      "type": "string"
    }
  },
  "required": [
    "follower_id",
    "podcast_id"
  ],
  "rls": {
    "create": {
      "data.follower_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "data.follower_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "data.follower_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}