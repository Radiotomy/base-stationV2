{
  "name": "BetaAccessRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Requesting user"
    },
    "user_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "feature": {
      "type": "string",
      "description": "Which beta feature was requested (e.g. Video Studio, Live Studio)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied"
      ],
      "default": "pending",
      "description": "Approval lifecycle, managed by admins"
    }
  },
  "required": [
    "user_id",
    "feature"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}