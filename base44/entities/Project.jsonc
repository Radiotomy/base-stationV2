{
  "name": "Project",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Project name"
    },
    "description": {
      "type": "string"
    },
    "cover_image_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "complete",
        "published"
      ],
      "default": "draft"
    },
    "track_asset_id": {
      "type": "string",
      "description": "Linked UserAsset ID for the track"
    },
    "track_url": {
      "type": "string"
    },
    "lyrics_asset_id": {
      "type": "string",
      "description": "Linked UserAsset ID for lyrics"
    },
    "lyrics_text": {
      "type": "string"
    },
    "cover_art_asset_id": {
      "type": "string"
    },
    "video_asset_id": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "mood": {
      "type": "string"
    },
    "bpm": {
      "type": "number"
    },
    "musical_key": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_public": {
      "type": "boolean",
      "default": false
    },
    "submission_id": {
      "type": "string",
      "description": "Linked TrackSubmission ID if published"
    },
    "workflow": {
      "type": "object",
      "description": "Phase 3: Step-by-step creative workflow timeline",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Tool used (lyrics, music, stems, mashup, harmony, master, cover_art, video, visualizer, audius_import)"
              },
              "asset_id": {
                "type": "string",
                "description": "UserAsset created or used at this step"
              },
              "tool_route": {
                "type": "string",
                "description": "Studio route, e.g., /mastering-studio"
              },
              "label": {
                "type": "string",
                "description": "Human-readable label for the step"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "user_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}