{
  "name": "Tip",
  "type": "object",
  "properties": {
    "from_user_id": {
      "type": "string"
    },
    "from_user_name": {
      "type": "string"
    },
    "from_user_email": {
      "type": "string"
    },
    "to_artist_id": {
      "type": "string"
    },
    "to_artist_name": {
      "type": "string"
    },
    "to_artist_email": {
      "type": "string"
    },
    "amount_cents": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "usd"
    },
    "message": {
      "type": "string"
    },
    "track_title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "blockchain": {
      "type": "string",
      "enum": [
        "base",
        "solana",
        "fiat"
      ],
      "default": "base",
      "description": "Blockchain used for the tip"
    }
  },
  "required": [
    "to_artist_id",
    "to_artist_name",
    "amount_cents"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "data.to_artist_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}