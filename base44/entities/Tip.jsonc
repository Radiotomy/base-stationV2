{
  "name": "Tip",
  "type": "object",
  "description": "A fan-to-artist tip. Non-custodial: crypto tips move wallet-to-wallet and are only recorded after the transaction is verified on-chain; the platform never holds the funds.",
  "properties": {
    "from_user_id": {
      "type": "string"
    },
    "from_user_name": {
      "type": "string"
    },
    "from_user_email": {
      "type": "string"
    },
    "to_artist_id": {
      "type": "string"
    },
    "to_artist_name": {
      "type": "string"
    },
    "to_artist_email": {
      "type": "string"
    },
    "amount_cents": {
      "type": "number",
      "description": "USD amount for fiat tips only"
    },
    "currency": {
      "type": "string",
      "default": "usd"
    },
    "token_symbol": {
      "type": "string",
      "description": "ETH or SOL for on-chain tips"
    },
    "token_amount": {
      "type": "number",
      "description": "Verified on-chain amount received by the artist"
    },
    "tx_hash": {
      "type": "string",
      "description": "Verified transaction hash / signature. Unique per tip to prevent replay."
    },
    "from_wallet": {
      "type": "string"
    },
    "to_wallet": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "track_title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "blockchain": {
      "type": "string",
      "enum": [
        "base",
        "solana",
        "audius",
        "fiat"
      ],
      "default": "base",
      "description": "Rail used for the tip"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "to_artist_id",
    "to_artist_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "data.to_artist_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}