{
  "name": "Persist Submitted Track Media",
  "description": "Copies externally-hosted track/cover files from new submissions into Base44 storage so links never expire.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "TrackSubmission"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "persist_submitted_track_media",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "persistExternalMedia",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}