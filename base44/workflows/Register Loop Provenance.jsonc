{
  "name": "Register Loop Provenance",
  "description": "Creates the BASE Mark registry row for every newly generated loop. A loop lives in LoopSample, but the forensic registry is indexed on UserAsset \u2014 an unregistered payload is discarded as a false positive, so without this row a marked loop could never be attributed. Creating the row is also what triggers the existing auto-mark cascade. Imported/CC0 samples are skipped inside the function: they are somebody else's recording.",
  "trigger": {
    "condition": "${ (.trigger.data.source == \"soundforge\" and .trigger.data.base_mark_asset_id == null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "LoopSample"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "register_loop_provenance",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "register_row": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "registerLoopProvenance",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}