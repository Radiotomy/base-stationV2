{
  "name": "Provider Balance Refresh",
  "description": "Refreshes credit balances and health status for all AI music providers (Nuro, Sonic, Producer, TempColor, LTX) every 6 hours.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 6,
      "interval_unit": "hours",
      "interval_anchor": "2026-05-28T19:26:59.914000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "provider_balance_refresh",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "refreshProviderBalances",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}