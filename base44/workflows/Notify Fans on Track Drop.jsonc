{
  "name": "Notify Fans on Track Drop",
  "description": "When a TrackSubmission is approved, email all of the artist's followers and post a track-drop item to the community activity feed.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "TrackSubmission"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_fans_on_track_drop",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyFansTrackDrop",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}