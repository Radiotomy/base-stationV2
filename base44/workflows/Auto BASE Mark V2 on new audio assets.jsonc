{
  "name": "Auto BASE Mark V2 on new audio assets",
  "description": "Automatically embeds a BASE Mark V2 neural watermark into every newly saved audio asset (tracks, stems, masters, harmonies, mashups, sfx, generated loops) via Replicate, completing asynchronously through the webhook finalizer.",
  "trigger": {
    "condition": "${ ((.trigger.data.asset_type == \"track\" or .trigger.data.asset_type == \"stem\" or .trigger.data.asset_type == \"master\" or .trigger.data.asset_type == \"harmony\" or .trigger.data.asset_type == \"mashup\" or .trigger.data.asset_type == \"sfx\" or .trigger.data.asset_type == \"loop\") and (.trigger.data.metadata.base_mark == null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "UserAsset"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_base_mark_v2_on_new_audio_assets",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoBaseMarkV2",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}